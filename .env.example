# Copy to `.env` and fill in values before V7 judge commands or Docker:
#   cp .env.example .env
#
# Never commit `.env` (it is gitignored). `.env.example` is safe to commit.

# OpenRouter API key for V7 recap-honesty judging (optional for make check /
# make grade / make docker-demo without V7). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default V7 model on OpenRouter. Client-facing recommendation: Sonnet.
# Examples: anthropic/claude-sonnet-5 | openai/gpt-4o-mini | anthropic/claude-opus-5.5
REBOOK_JUDGE_MODEL=anthropic/claude-sonnet-5

# Optional: set to 1 only when running `make test-gym` (Makefile sets this).
# REBOOK_TEST_GYM=0
